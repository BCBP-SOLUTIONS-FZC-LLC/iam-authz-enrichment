# Private module access (SSH key or GO_PRIVATE_TOKEN must be configured for github.com/BCBP-SOLUTIONS-FZC-LLC)
GOPRIVATE=github.com/BCBP-SOLUTIONS-FZC-LLC/*
GONOSUMDB=github.com/BCBP-SOLUTIONS-FZC-LLC/*

# Application
APP_NAME=iam-authz-enrichment
# One of local | dev | test | staging | prod (Enterprise Platform
# Observability Standard; "production"/"development" fail startup).
# APP_ENV, else ENVIRONMENT, else dev (config.ResolveAppEnv — same precedence
# as the platform libraries). One of local, dev, test, staging, prod.
APP_ENV=dev
# Registry domain for the {domain, service, environment} metric labels
# (cmd/server also sets "iam" explicitly).
OBSERVABILITY_DOMAIN=iam
APP_PORT=8080
# /metrics is served on its own dedicated port/listener, separate from
# APP_PORT (which now carries only /healthz and /readyz) — see
# cmd/server/main.go's metricsServer.
METRICS_PORT=9090
GRPC_PORT=9091

# Valkey — this service's only persistent-ish state (§1). TLS in-transit in
# prod/staging: use rediss://... . Tight timeouts because Valkey is treated
# as a soft dependency (§7: bypass on Valkey-down, don't fail closed).
VALKEY_URL=localhost:6384
VALKEY_DIAL_TIMEOUT=20ms
VALKEY_READ_TIMEOUT=10ms
# Separate Valkey client for SQS event processing (evictions / fact writes).
VALKEY_EVENT_TIMEOUT=500ms
VALKEY_WRITE_TIMEOUT=10ms

# Cache TTLs / jitter (§4.1) and the §7 stale-if-error hard cap (never
# exceeds 5m regardless of what this is set to).
AE_CTX_TTL=60s
AE_CTX_JITTER=6s
AE_TENDER_ACL_TTL=15s
AE_NEG_TTL=5s
# How long RestrictedTenderSet's L1 cache trusts a "not restricted" result
# before re-checking Valkey — bounds how fast this replica notices another
# replica's TenderRestricted event. Separate from AE_NEG_TTL (a
# subject-rebuild performance knob) since this one is a security-relevant
# propagation delay.
AE_RESTRICTED_NEG_TTL=5s
# Same knob as AE_RESTRICTED_NEG_TTL, for RealmMap: how long a "no such
# dedicated realm" result is trusted before re-checking Valkey for another
# replica's TenantConverted-driven Set.
AE_REALM_NEG_TTL=5s
AE_PROCESSED_EVENT_TTL=168h
AE_STALE_IF_ERROR_MAX_AGE=5m

# Org & Membership sibling service (§6) — I-8/I-14.
ORG_MEMBERSHIP_BASE_URL=http://localhost:8081
# 40ms covers O&M's I-8 p99 targets (15ms hit / 30ms miss) — LLD §16 AE-37.
ORG_MEMBERSHIP_TIMEOUT=40ms

# iam-tender-acl sibling service — TAC-4 (formerly I-12), repointed here
# from Org & Membership per ADR-0007 Wave 3 Phase 4.
TENDER_ACL_BASE_URL=http://localhost:8086
TENDER_ACL_TIMEOUT=30ms

# Server-side cap on each Check call (Envoy's grpc-timeout wins when shorter).
GRPC_REQUEST_TIMEOUT=250ms

# Tenant resolution (§2 point 3). SHARED_REALM_ISSUER is the Keycloak issuer
# for the shared trial realm; REALM_TENANT_MAP_SEED is a startup-only JSON
# seed for dedicated realms — kept fresh at runtime by the tenant-authz-q
# consumer (TenantConverted/TenantRealmReady), never re-read from here.
SHARED_REALM_ISSUER=https://kc.example.com/realms/shared-trial
REALM_TENANT_MAP_SEED={}

# Envoy jwt_authn dynamic-metadata location for verified JWT claims — see
# internal/adapter/inbound/grpc/claims.go.
JWT_METADATA_NAMESPACE=envoy.filters.http.jwt_authn
JWT_PAYLOAD_KEY=trial

# gRPC server tuning (§11). Message-size limits are deliberately far below
# gRPC-Go's 4MiB default — CheckRequest/CheckResponse payloads are small
# (a handful of claims and six headers); this is defense-in-depth, not a
# real operating limit.
GRPC_MAX_CONCURRENT_STREAMS=1000
GRPC_KEEPALIVE_TIME=30s
GRPC_KEEPALIVE_TIMEOUT=5s
GRPC_MAX_RECV_MSG_SIZE_BYTES=262144
GRPC_MAX_SEND_MSG_SIZE_BYTES=262144

# Optional app-level TLS for the gRPC server. Leave both blank if a service
# mesh sidecar or the CNI layer already terminates mTLS transparently — that
# is the intended deployment (see README § Security). Set
# GRPC_TLS_CLIENT_CA_FILE too to additionally require and verify a client
# certificate (mTLS) instead of server-side-only TLS.
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
GRPC_TLS_CLIENT_CA_FILE=

# AsyncAPI event-contract viewer (GET /asyncapi, GET /asyncapi.yaml —
# api/asyncapi.yaml, embedded at compile time). Outside APP_ENV=prod
# it's always mounted regardless of DOCS_ENABLED; in production it's
# opt-in via DOCS_ENABLED and, if DOCS_AUTH_TOKEN is set, additionally
# gated behind `Authorization: Bearer <token>`.
DOCS_ENABLED=false
DOCS_AUTH_TOKEN=

# OTel tracing and logging — read by platform-gincommon (cmd/server starts
# tracing with gincommon.InitTracingWithConfig, passing APP_NAME as the
# service name, so OTEL_SERVICE_NAME is not needed). "none" installs the
# in-process provider (trace IDs still work) without exporting — the right
# default with no local collector; unset falls back to localhost:4317 and logs
# a failed export on every flush. OTEL_EXPORTER_OTLP_INSECURE, left blank,
# defaults to plaintext when APP_ENV (then ENVIRONMENT) is local or dev.
OTEL_EXPORTER_OTLP_ENDPOINT=none
OTEL_EXPORTER_OTLP_INSECURE=
OTEL_TRACES_SAMPLER_RATIO=1.0
OTEL_PROPAGATOR_BAGGAGE=false
OTEL_TRACES_IGNORE_REMOTE_PARENT_SAMPLED=false
# debug | info | warn | error (default debug in dev/local, info otherwise).
LOG_LEVEL=debug
LOG_SAMPLING=false

# AWS / floci — five inbound SQS queues, zero outbound (§5). Leave a
# *_QUEUE_URL blank in APP_ENV=dev to start that consumer idle. Outside
# dev every URL is required (config.Load fails fast).
#
# floci (docker-compose.yml's `floci` service) is an open-source, always-
# free LocalStack-compatible AWS emulator — no Pro tier / auth token needed
# for SQS (the only AWS service this repo uses).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4571
MEMBERSHIP_AUTHZ_QUEUE_URL=http://localhost:4571/000000000000/membership-authz-q
USER_AUTHZ_QUEUE_URL=http://localhost:4571/000000000000/user-authz-q
BILLING_AUTHZ_QUEUE_URL=http://localhost:4571/000000000000/billing-authz-q
TENANT_AUTHZ_QUEUE_URL=http://localhost:4571/000000000000/tenant-authz-q
TENDER_AUTHZ_QUEUE_URL=http://localhost:4571/000000000000/tender-authz-q
# Shared platform-events SQS knobs (LoadSQS / SQSConsumerOptions).
# SQS_MAX_RECEIVE_COUNT is not used: the consumer pins its threshold to 4
# (one short of each queue's RedrivePolicy maxReceiveCount=5) and forwards
# the 5th delivery to the DLQ itself (LLD §16 AE-36). SQS_CONCURRENCY is
# overridden by the per-queue *_AUTHZ_QUEUE_CONCURRENCY vars below.
SQS_MAX_MESSAGES=10
SQS_WAIT_SECONDS=20
SQS_VISIBILITY_TIMEOUT=30s
SQS_HANDLER_TIMEOUT=20s
SQS_DRAIN_TIMEOUT=30s
# platform_queue_depth / platform_dlq_depth sampling; 0 or unset disables it.
SQS_QUEUE_DEPTH_INTERVAL=60s

# No DATABASE_URL / PG_* / MIGRATION_DATABASE_URL / SYSTEM_DATABASE_URL /
# OUTBOX_* / SNS_TOPIC_ARN: this service has no database and publishes no
# events (HLD §5.4). cmd/server still loads those configs through
# platform-pgcommon / platform-events for parity and logs a warning if any
# is set — it never opens a pool, runs an outbox or creates a publisher.

# events.WithConcurrency per queue — messages each consumer hands to handler
# goroutines at once, instead of platform-events' default of 1 (fully
# serial per queue). Same per-queue-configurable pattern as
# iam-org-membership's SQS_*_CONCURRENCY vars.
MEMBERSHIP_AUTHZ_QUEUE_CONCURRENCY=4
USER_AUTHZ_QUEUE_CONCURRENCY=4
BILLING_AUTHZ_QUEUE_CONCURRENCY=4
TENANT_AUTHZ_QUEUE_CONCURRENCY=4
TENDER_AUTHZ_QUEUE_CONCURRENCY=4
